# ---- 旧 CLI 批处理配置 ----
# 企业微信机器人 Webhook（可选，留空则停用企微推送）
PUSHER_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY_HERE

# ---- 新 AI 助手服务配置 ----
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# 企业微信机器人 Webhook（可选，留空则停用企微推送）
WECOM_WEBHOOK_URL=
# Telegram 为可选双通道；两个字段必须同时填写或同时留空
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram API 代理（国内服务器需要，Docker 内用 host.docker.internal）
TELEGRAM_PROXY=http://host.docker.internal:1082

# ---- 飞书推送通道（可选，复用 hermes 飞书应用机器人）----
# 三个字段必须同时填写，或全部留空（留空则不启用飞书通道）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 推送目标：群 chat_id（oc_ 开头）或用户 open_id（ou_ 开头）
FEISHU_CHAT_ID=
TZ=Asia/Shanghai
# RSS 订阅源（多个用英文逗号分隔）
NEWS_RSS_URLS=https://www.qbitai.com/feed
# HuggingFace 代理（Docker 内必须用 host.docker.internal，不能写 127.0.0.1）
HF_PROXY=http://host.docker.internal:8899
# 将 HuggingFace 视为可选源；开启后超时只记 skipped，不污染 health 失败状态
HF_OPTIONAL=0
# 连续失败达到该次数后，在 /health 中标记来源为 degraded
SOURCE_FAILURE_DEGRADED_THRESHOLD=3
# 选材来源多样性策略：linear（默认，可回滚）或 exponential（需回放验证后启用）
SELECTION_DIVERSITY_PENALTY_PROFILE=linear
# 同热点聚合默认关闭；仅在标注集达到 200 / 2% / 15% 门槛后启用
TOPIC_CLUSTER_ENABLED=0
TOPIC_CLUSTER_SIMILARITY_THRESHOLD=0.70
TOPIC_CLUSTER_MAX_ROUNDS=10
# LLM 相关性复核默认关闭；启用后复用摘要调用，不增加第二次 LLM 请求
LLM_RELEVANCE_ENABLED=0
LLM_RELEVANCE_THRESHOLD=0.50

# ---- 网站内容发布库（v1.0.0）----
# 开启后必须提供 PostgreSQL 连接；未开启时保留现有仅 JSON 审计模式。
PUBLICATION_ENABLED=0
PUBLICATION_DATABASE_URL=

# ---- AI RSS 多源配置 ----
# 追加默认 AI 源；若改成 replace，则只使用下列配置
AI_RSS_MODE=append
AI_RSS_FEEDS=
